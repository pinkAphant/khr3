{
  "name": "@khr3/core",
  "version": "0.2.11",
  "description": "KHR_physics_rigid_bodies + KHR_implicit_shapes loader, exporter, Rapier assembly and ecctrl vehicle rig for React Three Fiber",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vehicle": {
      "types": "./dist/vehicle.d.ts",
      "import": "./dist/vehicle.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts*\"",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && vite build && tsc -p tsconfig.build.json",
    "prepack": "npm run build >&2",
    "pack:dry": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@dimforge/rapier3d-compat": "0.19.2",
    "@pinkaphant/ecctrl": "2.0.4-beta.5",
    "@react-three/fiber": "^9.0.0",
    "@react-three/rapier": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": ">=0.159.0"
  },
  "peerDependenciesMeta": {
    "@pinkaphant/ecctrl": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.19.2",
    "@pinkaphant/ecctrl": "2.0.4-beta.5",
    "@react-three/fiber": "^9.6.1",
    "@react-three/rapier": "^2.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.184.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^8.3.8"
  },
  "keywords": [
    "gltf",
    "khr_physics_rigid_bodies",
    "rapier",
    "react-three-fiber",
    "ecctrl",
    "vehicle"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinkAphant/khr3.git"
  },
  "bugs": {
    "url": "https://github.com/pinkAphant/khr3/issues"
  }
}
